    "/tools/validate_domain_facts": {
      "post": {
        "operationId": "validate_domain_facts",
        "description": "【领域规则守门】只读校验 Markdown 草稿是否违反 domain_rules.md 中由原文/世界模型/审核反馈生成的通用领域规则；不写文件，不内置题材硬编码。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "book_name": {
                    "type": "string"
                  },
                  "book_id": {
                    "type": "string"
                  },
                  "file_name": {
                    "type": "string",
                    "default": "chapter_draft.md",
                    "enum": [
                      "chapter_draft.md"
                    ],
                    "description": "默认校验当前续写草稿 chapter_draft.md。"
                  },
                  "rules_file": {
                    "type": "string",
                    "default": "domain_rules.md",
                    "enum": [
                      "domain_rules.md"
                    ],
                    "description": "领域规则文件。规则必须来自当前书籍原文、世界模型或审核反馈生成，不由代码硬编码。"
                  },
                  "markdown": {
                    "type": "string",
                    "description": "可选的内联 Markdown 片段。提供后校验该片段而不是 file_name，用于 world/review agent 对新生成规则做最小正反例烟测；最大 50000 字符。"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功返回领域规则校验结果。ok=false 表示存在解析错误或规则违例。"
          },
          "400": {
            "description": "参数错误，或 file_name/rules_file 越界。"
          },
          "404": {
            "description": "书籍、草稿文件或领域规则文件不存在。"
          }
        }
      }
    },
    "/api/draft/replace_text": {
      "post": {
        "operationId": "draft_replace_text",
        "description": "Exact local text replacement for Dify Agents. Use this for review rejects and bounded self-revision when only one sentence, phrase, or short paragraph should change. It does not use a writes array and must not add chapters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "file_name",
                  "old_text",
                  "new_text",
                  "base_etag",
                  "origin"
                ],
                "properties": {
                  "book_name": {
                    "type": "string"
                  },
                  "book_id": {
                    "type": "string"
                  },
                  "file_name": {
                    "type": "string",
                    "enum": [
                      "summary.md",
                      "status_card.md",
                      "world_model.md",
                      "style_guide.md",
                      "style_constraints_for_continuation.md",
                      "style_review.md",
                      "style_fingerprint.md",
                      "error_archive.md",
                      "brainstorm.md",
                      "master_outline.md",
                      "arc_outline.md",
                      "chapter_outline.md",
                      "chapter_draft.md",
                      "domain_rules.md"
                    ]
                  },
                  "old_text": {
                    "type": "string",
                    "description": "Exact text copied from the current file. Prefer one sentence or one short contiguous paragraph."
                  },
                  "new_text": {
                    "type": "string",
                    "description": "Replacement text for that exact span only. Do not include unrelated chapter content."
                  },
                  "occurrence": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Optional 1-based match index when old_text appears multiple times."
                  },
                  "base_etag": {
                    "type": "string",
                    "description": "Current file etag returned by get_markdown_outline, get_markdown_section, get_archive_range, or get_core_archive."
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "explicit_user_write"
                    ],
                    "description": "Must be explicit_user_write."
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Text replacement committed to draft/sandbox."
          }
        }
      }
    }
  }
